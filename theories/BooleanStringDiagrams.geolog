    rw is_and_not,
    [rw: rw, gate: glhs0] and_not_lhs_0,
    [rw: rw, gate: grhs0] and_not_rhs_0,
    [gate: glhs0, wire: w] copy_in
    |- [gate: grhs0, wire: w] discard_in;
  strict ax/and_not_wire_y_1 : forall rw: Cell, glhs2: Cell, grhs1: Cell, w: Cell.
    rw is_and_not,
    [rw: rw, gate: glhs2] and_not_lhs_2,
    [rw: rw, gate: grhs1] and_not_rhs_1,
    [gate: glhs2, wire: w] and_out
    |- [gate: grhs1, wire: w] const0_out;

  // ========== LAYER 4: Proof well-formedness ==========

  // LHS/RHS membership (marked by the problem definition)
  in_lhs : Cell -> Prop;
  in_rhs : Cell -> Prop;

  // Reachability: transitive closure of the proof-order relation
  before : [from: Cell, to: Cell] -> Prop;

  // Base cases: boundary implies ordering
  ax/before_neg : forall a: Cell, b: Cell.
    [higher: b, lower: a] neg |- [from: a, to: b] before;
  ax/before_pos : forall a: Cell, b: Cell.
    [higher: a, lower: b] pos |- [from: b, to: a] before;
  // Transitivity
  ax/before_trans : forall a: Cell, b: Cell, c: Cell.
    [from: a, to: b] before, [from: b, to: c] before
    |- [from: a, to: c] before;

  // ACYCLICITY: no cell is before itself
  strict ax/acyclic : forall a: Cell. [from: a, to: a] before |- false;

  // GLOBULARITY / DOUBLE-BOUNDARY COHERENCE
  // A wire seen across a rewrite via mixed polarity (pos→neg or neg→pos)
  // must also be seen via same polarity (pos→pos or neg→neg), and conversely.
  // This prevents holes where a rewrite touches gates whose boundary wires do not
  // line up as a genuine 2-cell boundary.
  strict ax/glob_pos_neg : forall rw: Cell, g: Cell, w: Cell.
    rw is_rewrite, [higher: rw, lower: g] pos, [higher: g, lower: w] neg
    |- (exists gp: Cell. [higher: rw, lower: gp] pos, [higher: gp, lower: w] pos) \/
       (exists gn: Cell. [higher: rw, lower: gn] neg, [higher: gn, lower: w] neg);
  strict ax/glob_neg_pos : forall rw: Cell, g: Cell, w: Cell.
    rw is_rewrite, [higher: rw, lower: g] neg, [higher: g, lower: w] pos
    |- (exists gp: Cell. [higher: rw, lower: gp] pos, [higher: gp, lower: w] pos) \/
       (exists gn: Cell. [higher: rw, lower: gn] neg, [higher: gn, lower: w] neg);
  strict ax/glob_pos_pos : forall rw: Cell, g: Cell, w: Cell.
    rw is_rewrite, [higher: rw, lower: g] pos, [higher: g, lower: w] pos
    |- (exists gp: Cell. [higher: rw, lower: gp] pos, [higher: gp, lower: w] neg) \/
       (exists gn: Cell. [higher: rw, lower: gn] neg, [higher: gn, lower: w] pos);
  strict ax/glob_neg_neg : forall rw: Cell, g: Cell, w: Cell.
    rw is_rewrite, [higher: rw, lower: g] neg, [higher: g, lower: w] neg
    |- (exists gp: Cell. [higher: rw, lower: gp] pos, [higher: gp, lower: w] neg) \/
       (exists gn: Cell. [higher: rw, lower: gn] neg, [higher: gn, lower: w] pos);

  // COVERAGE: every gate must be accounted for
  // Intuition: this literally checks that there are no holes in the proof.
  // A gate is covered on the positive side if it is explicitly part of the starting LHS
  // or is produced by the positive boundary of some rewrite.
  // A gate is covered on the negative side if it is explicitly part of the final RHS
  // or is consumed by the negative boundary of some rewrite.
  // If a gate is unchanged by the proof (a whiskered / passthrough gate), it can simply
  // be marked both `in_lhs` and `in_rhs` rather than being mentioned in any rewrite.
  strict ax/coverage_pos : forall c: Cell.
    c is_gate
    |- c in_lhs \/ (exists h: Cell. [higher: h, lower: c] pos);
  strict ax/coverage_neg : forall c: Cell.
    c is_gate
    |- c in_rhs \/ (exists h: Cell. [higher: h, lower: c] neg);

}
