// Boolean String Diagrams as Cell Complexes
// AUTO-GENERATED by scripts/gen_boolean_theory.py
//
// 0-cells = wires, 1-cells = gates, 2-cells = rewrite steps
// Axioms are layered for chase evaluation:
//   Layer 1: rewrite structure -> gate types + boundary
//   Layer 2: gate ports -> boundary + wire rank + uniqueness
//   Layer 3: rewrite + ports -> wire identifications

theory BoolCircuits {
  Cell : Sort;

  // Rank predicates
  is_wire : Cell -> Prop;
  is_gate : Cell -> Prop;
  is_rewrite : Cell -> Prop;

  // Boundary relations
  neg : [higher: Cell, lower: Cell] -> Prop;
  pos : [higher: Cell, lower: Cell] -> Prop;

  // === Gate types ===
  is_not : Cell -> Prop;
  is_and : Cell -> Prop;
  is_copy : Cell -> Prop;
  is_discard : Cell -> Prop;
  is_const0 : Cell -> Prop;
  is_const1 : Cell -> Prop;
  is_sym : Cell -> Prop;

  // === Port relations ===
  not_in : [gate: Cell, wire: Cell] -> Prop;
  not_out : [gate: Cell, wire: Cell] -> Prop;
  and_in_0 : [gate: Cell, wire: Cell] -> Prop;
  and_in_1 : [gate: Cell, wire: Cell] -> Prop;
  and_out : [gate: Cell, wire: Cell] -> Prop;
  copy_in : [gate: Cell, wire: Cell] -> Prop;
  copy_out_0 : [gate: Cell, wire: Cell] -> Prop;
  copy_out_1 : [gate: Cell, wire: Cell] -> Prop;
  discard_in : [gate: Cell, wire: Cell] -> Prop;
  const0_out : [gate: Cell, wire: Cell] -> Prop;
  const1_out : [gate: Cell, wire: Cell] -> Prop;
  sym_in_0 : [gate: Cell, wire: Cell] -> Prop;
  sym_in_1 : [gate: Cell, wire: Cell] -> Prop;
  sym_out_0 : [gate: Cell, wire: Cell] -> Prop;
  sym_out_1 : [gate: Cell, wire: Cell] -> Prop;

  // === Rewrite rule types ===
  is_not_not : Cell -> Prop;
  is_const0_not : Cell -> Prop;
  is_const1_not : Cell -> Prop;
  is_and_const1 : Cell -> Prop;
  is_and_const0 : Cell -> Prop;
  is_and_comm : Cell -> Prop;
  is_and_idem : Cell -> Prop;
  is_copy_not : Cell -> Prop;
  is_copy_counit_left : Cell -> Prop;
  is_copy_counit_right : Cell -> Prop;
  is_copy_cosym : Cell -> Prop;
  is_const0_copy : Cell -> Prop;
  is_const1_copy : Cell -> Prop;
  is_not_discard : Cell -> Prop;
  is_and_discard : Cell -> Prop;
  is_const0_discard : Cell -> Prop;
  is_const1_discard : Cell -> Prop;
  is_copy_discard : Cell -> Prop;
  is_and_not : Cell -> Prop;

  // === Rewrite structure relations ===
  not_not_lhs_0 : [rw: Cell, gate: Cell] -> Prop;
  not_not_lhs_1 : [rw: Cell, gate: Cell] -> Prop;
  const0_not_lhs_0 : [rw: Cell, gate: Cell] -> Prop;
  const0_not_lhs_1 : [rw: Cell, gate: Cell] -> Prop;
  const0_not_rhs_0 : [rw: Cell, gate: Cell] -> Prop;
  const1_not_lhs_0 : [rw: Cell, gate: Cell] -> Prop;
  const1_not_lhs_1 : [rw: Cell, gate: Cell] -> Prop;
  const1_not_rhs_0 : [rw: Cell, gate: Cell] -> Prop;
  and_const1_lhs_0 : [rw: Cell, gate: Cell] -> Prop;
  and_const1_lhs_1 : [rw: Cell, gate: Cell] -> Prop;
  and_const0_lhs_0 : [rw: Cell, gate: Cell] -> Prop;
  and_const0_lhs_1 : [rw: Cell, gate: Cell] -> Prop;
  and_const0_rhs_0 : [rw: Cell, gate: Cell] -> Prop;
  and_const0_rhs_1 : [rw: Cell, gate: Cell] -> Prop;
  and_comm_lhs_0 : [rw: Cell, gate: Cell] -> Prop;
  and_comm_lhs_1 : [rw: Cell, gate: Cell] -> Prop;
  and_comm_rhs_0 : [rw: Cell, gate: Cell] -> Prop;
  and_idem_lhs_0 : [rw: Cell, gate: Cell] -> Prop;
  and_idem_lhs_1 : [rw: Cell, gate: Cell] -> Prop;
  copy_not_lhs_0 : [rw: Cell, gate: Cell] -> Prop;
  copy_not_lhs_1 : [rw: Cell, gate: Cell] -> Prop;
  copy_not_lhs_2 : [rw: Cell, gate: Cell] -> Prop;
  copy_not_rhs_0 : [rw: Cell, gate: Cell] -> Prop;
  copy_not_rhs_1 : [rw: Cell, gate: Cell] -> Prop;
  copy_counit_left_lhs_0 : [rw: Cell, gate: Cell] -> Prop;
  copy_counit_left_lhs_1 : [rw: Cell, gate: Cell] -> Prop;
  copy_counit_right_lhs_0 : [rw: Cell, gate: Cell] -> Prop;
  copy_counit_right_lhs_1 : [rw: Cell, gate: Cell] -> Prop;
  copy_cosym_lhs_0 : [rw: Cell, gate: Cell] -> Prop;
  copy_cosym_lhs_1 : [rw: Cell, gate: Cell] -> Prop;
  copy_cosym_rhs_0 : [rw: Cell, gate: Cell] -> Prop;
  const0_copy_lhs_0 : [rw: Cell, gate: Cell] -> Prop;
  const0_copy_lhs_1 : [rw: Cell, gate: Cell] -> Prop;
  const0_copy_rhs_0 : [rw: Cell, gate: Cell] -> Prop;
  const0_copy_rhs_1 : [rw: Cell, gate: Cell] -> Prop;
  const1_copy_lhs_0 : [rw: Cell, gate: Cell] -> Prop;
  const1_copy_lhs_1 : [rw: Cell, gate: Cell] -> Prop;
  const1_copy_rhs_0 : [rw: Cell, gate: Cell] -> Prop;
  const1_copy_rhs_1 : [rw: Cell, gate: Cell] -> Prop;
  not_discard_lhs_0 : [rw: Cell, gate: Cell] -> Prop;
  not_discard_lhs_1 : [rw: Cell, gate: Cell] -> Prop;
  not_discard_rhs_0 : [rw: Cell, gate: Cell] -> Prop;
  and_discard_lhs_0 : [rw: Cell, gate: Cell] -> Prop;
  and_discard_lhs_1 : [rw: Cell, gate: Cell] -> Prop;
  and_discard_rhs_0 : [rw: Cell, gate: Cell] -> Prop;
  and_discard_rhs_1 : [rw: Cell, gate: Cell] -> Prop;
  const0_discard_lhs_0 : [rw: Cell, gate: Cell] -> Prop;
  const0_discard_lhs_1 : [rw: Cell, gate: Cell] -> Prop;
  const1_discard_lhs_0 : [rw: Cell, gate: Cell] -> Prop;
  const1_discard_lhs_1 : [rw: Cell, gate: Cell] -> Prop;
  copy_discard_lhs_0 : [rw: Cell, gate: Cell] -> Prop;
  copy_discard_lhs_1 : [rw: Cell, gate: Cell] -> Prop;
  copy_discard_lhs_2 : [rw: Cell, gate: Cell] -> Prop;
  copy_discard_rhs_0 : [rw: Cell, gate: Cell] -> Prop;
  and_not_lhs_0 : [rw: Cell, gate: Cell] -> Prop;
  and_not_lhs_1 : [rw: Cell, gate: Cell] -> Prop;
  and_not_lhs_2 : [rw: Cell, gate: Cell] -> Prop;
  and_not_rhs_0 : [rw: Cell, gate: Cell] -> Prop;
  and_not_rhs_1 : [rw: Cell, gate: Cell] -> Prop;

  // ========== LAYER 1: Rank constraints ==========

  ax/neg_gate_wire : forall g: Cell, w: Cell.
    g is_gate, [higher: g, lower: w] neg |- w is_wire;
  ax/pos_gate_wire : forall g: Cell, w: Cell.
    g is_gate, [higher: g, lower: w] pos |- w is_wire;
  ax/neg_rw_gate : forall r: Cell, c: Cell.
    r is_rewrite, [higher: r, lower: c] neg |- c is_gate;
  ax/pos_rw_gate : forall r: Cell, c: Cell.
    r is_rewrite, [higher: r, lower: c] pos |- c is_gate;

  // ========== LAYER 2: Gate port axioms ==========

  // --- not ---
  ax/not_in_neg : forall g: Cell, w: Cell.
    g is_not, [gate: g, wire: w] not_in |- [higher: g, lower: w] neg;
  ax/not_in_wire : forall g: Cell, w: Cell.
    [gate: g, wire: w] not_in |- w is_wire;
  ax/not_in_uniq : forall g: Cell, w1: Cell, w2: Cell.
    [gate: g, wire: w1] not_in, [gate: g, wire: w2] not_in |- w1 = w2;
  ax/not_out_pos : forall g: Cell, w: Cell.
    g is_not, [gate: g, wire: w] not_out |- [higher: g, lower: w] pos;
  ax/not_out_wire : forall g: Cell, w: Cell.
    [gate: g, wire: w] not_out |- w is_wire;
  ax/not_out_uniq : forall g: Cell, w1: Cell, w2: Cell.
    [gate: g, wire: w1] not_out, [gate: g, wire: w2] not_out |- w1 = w2;

  // --- and ---
  ax/and_in_0_neg : forall g: Cell, w: Cell.
    g is_and, [gate: g, wire: w] and_in_0 |- [higher: g, lower: w] neg;
  ax/and_in_0_wire : forall g: Cell, w: Cell.
    [gate: g, wire: w] and_in_0 |- w is_wire;
  ax/and_in_0_uniq : forall g: Cell, w1: Cell, w2: Cell.
    [gate: g, wire: w1] and_in_0, [gate: g, wire: w2] and_in_0 |- w1 = w2;
  ax/and_in_1_neg : forall g: Cell, w: Cell.
    g is_and, [gate: g, wire: w] and_in_1 |- [higher: g, lower: w] neg;
  ax/and_in_1_wire : forall g: Cell, w: Cell.
    [gate: g, wire: w] and_in_1 |- w is_wire;
  ax/and_in_1_uniq : forall g: Cell, w1: Cell, w2: Cell.
    [gate: g, wire: w1] and_in_1, [gate: g, wire: w2] and_in_1 |- w1 = w2;
  ax/and_out_pos : forall g: Cell, w: Cell.
    g is_and, [gate: g, wire: w] and_out |- [higher: g, lower: w] pos;
  ax/and_out_wire : forall g: Cell, w: Cell.
    [gate: g, wire: w] and_out |- w is_wire;
  ax/and_out_uniq : forall g: Cell, w1: Cell, w2: Cell.
    [gate: g, wire: w1] and_out, [gate: g, wire: w2] and_out |- w1 = w2;

  // --- copy ---
  ax/copy_in_neg : forall g: Cell, w: Cell.
    g is_copy, [gate: g, wire: w] copy_in |- [higher: g, lower: w] neg;
  ax/copy_in_wire : forall g: Cell, w: Cell.
    [gate: g, wire: w] copy_in |- w is_wire;
  ax/copy_in_uniq : forall g: Cell, w1: Cell, w2: Cell.
    [gate: g, wire: w1] copy_in, [gate: g, wire: w2] copy_in |- w1 = w2;
  ax/copy_out_0_pos : forall g: Cell, w: Cell.
    g is_copy, [gate: g, wire: w] copy_out_0 |- [higher: g, lower: w] pos;
  ax/copy_out_0_wire : forall g: Cell, w: Cell.
    [gate: g, wire: w] copy_out_0 |- w is_wire;
  ax/copy_out_0_uniq : forall g: Cell, w1: Cell, w2: Cell.
    [gate: g, wire: w1] copy_out_0, [gate: g, wire: w2] copy_out_0 |- w1 = w2;
  ax/copy_out_1_pos : forall g: Cell, w: Cell.
    g is_copy, [gate: g, wire: w] copy_out_1 |- [higher: g, lower: w] pos;
  ax/copy_out_1_wire : forall g: Cell, w: Cell.
    [gate: g, wire: w] copy_out_1 |- w is_wire;
  ax/copy_out_1_uniq : forall g: Cell, w1: Cell, w2: Cell.
    [gate: g, wire: w1] copy_out_1, [gate: g, wire: w2] copy_out_1 |- w1 = w2;

  // --- discard ---
  ax/discard_in_neg : forall g: Cell, w: Cell.
    g is_discard, [gate: g, wire: w] discard_in |- [higher: g, lower: w] neg;
  ax/discard_in_wire : forall g: Cell, w: Cell.
    [gate: g, wire: w] discard_in |- w is_wire;
  ax/discard_in_uniq : forall g: Cell, w1: Cell, w2: Cell.
    [gate: g, wire: w1] discard_in, [gate: g, wire: w2] discard_in |- w1 = w2;

  // --- const0 ---
  ax/const0_out_pos : forall g: Cell, w: Cell.
    g is_const0, [gate: g, wire: w] const0_out |- [higher: g, lower: w] pos;
  ax/const0_out_wire : forall g: Cell, w: Cell.
    [gate: g, wire: w] const0_out |- w is_wire;
  ax/const0_out_uniq : forall g: Cell, w1: Cell, w2: Cell.
    [gate: g, wire: w1] const0_out, [gate: g, wire: w2] const0_out |- w1 = w2;

  // --- const1 ---
  ax/const1_out_pos : forall g: Cell, w: Cell.
    g is_const1, [gate: g, wire: w] const1_out |- [higher: g, lower: w] pos;
  ax/const1_out_wire : forall g: Cell, w: Cell.
    [gate: g, wire: w] const1_out |- w is_wire;
  ax/const1_out_uniq : forall g: Cell, w1: Cell, w2: Cell.
    [gate: g, wire: w1] const1_out, [gate: g, wire: w2] const1_out |- w1 = w2;

  // --- sym ---
  ax/sym_in_0_neg : forall g: Cell, w: Cell.
    g is_sym, [gate: g, wire: w] sym_in_0 |- [higher: g, lower: w] neg;
  ax/sym_in_0_wire : forall g: Cell, w: Cell.
    [gate: g, wire: w] sym_in_0 |- w is_wire;
  ax/sym_in_0_uniq : forall g: Cell, w1: Cell, w2: Cell.
    [gate: g, wire: w1] sym_in_0, [gate: g, wire: w2] sym_in_0 |- w1 = w2;
  ax/sym_in_1_neg : forall g: Cell, w: Cell.
    g is_sym, [gate: g, wire: w] sym_in_1 |- [higher: g, lower: w] neg;
  ax/sym_in_1_wire : forall g: Cell, w: Cell.
    [gate: g, wire: w] sym_in_1 |- w is_wire;
  ax/sym_in_1_uniq : forall g: Cell, w1: Cell, w2: Cell.
    [gate: g, wire: w1] sym_in_1, [gate: g, wire: w2] sym_in_1 |- w1 = w2;
  ax/sym_out_0_pos : forall g: Cell, w: Cell.
    g is_sym, [gate: g, wire: w] sym_out_0 |- [higher: g, lower: w] pos;
  ax/sym_out_0_wire : forall g: Cell, w: Cell.
    [gate: g, wire: w] sym_out_0 |- w is_wire;
  ax/sym_out_0_uniq : forall g: Cell, w1: Cell, w2: Cell.
    [gate: g, wire: w1] sym_out_0, [gate: g, wire: w2] sym_out_0 |- w1 = w2;
  ax/sym_out_1_pos : forall g: Cell, w: Cell.
    g is_sym, [gate: g, wire: w] sym_out_1 |- [higher: g, lower: w] pos;
  ax/sym_out_1_wire : forall g: Cell, w: Cell.
    [gate: g, wire: w] sym_out_1 |- w is_wire;
  ax/sym_out_1_uniq : forall g: Cell, w1: Cell, w2: Cell.
    [gate: g, wire: w1] sym_out_1, [gate: g, wire: w2] sym_out_1 |- w1 = w2;

  // --- Gate type mutual exclusivity ---
  ax/excl_not_and : forall g: Cell. g is_not, g is_and |- false;
  ax/excl_not_copy : forall g: Cell. g is_not, g is_copy |- false;
  ax/excl_not_discard : forall g: Cell. g is_not, g is_discard |- false;
  ax/excl_not_const0 : forall g: Cell. g is_not, g is_const0 |- false;
  ax/excl_not_const1 : forall g: Cell. g is_not, g is_const1 |- false;
  ax/excl_not_sym : forall g: Cell. g is_not, g is_sym |- false;
  ax/excl_and_copy : forall g: Cell. g is_and, g is_copy |- false;
  ax/excl_and_discard : forall g: Cell. g is_and, g is_discard |- false;
  ax/excl_and_const0 : forall g: Cell. g is_and, g is_const0 |- false;
  ax/excl_and_const1 : forall g: Cell. g is_and, g is_const1 |- false;
  ax/excl_and_sym : forall g: Cell. g is_and, g is_sym |- false;
  ax/excl_copy_discard : forall g: Cell. g is_copy, g is_discard |- false;
  ax/excl_copy_const0 : forall g: Cell. g is_copy, g is_const0 |- false;
  ax/excl_copy_const1 : forall g: Cell. g is_copy, g is_const1 |- false;
  ax/excl_copy_sym : forall g: Cell. g is_copy, g is_sym |- false;
  ax/excl_discard_const0 : forall g: Cell. g is_discard, g is_const0 |- false;
  ax/excl_discard_const1 : forall g: Cell. g is_discard, g is_const1 |- false;
  ax/excl_discard_sym : forall g: Cell. g is_discard, g is_sym |- false;
  ax/excl_const0_const1 : forall g: Cell. g is_const0, g is_const1 |- false;
  ax/excl_const0_sym : forall g: Cell. g is_const0, g is_sym |- false;
  ax/excl_const1_sym : forall g: Cell. g is_const1, g is_sym |- false;

  // ========== LAYER 3: Rewrite rule axioms ==========

  // --- not_not ---
  ax/not_not_lhs0_type : forall rw: Cell, g: Cell.
    rw is_not_not, [rw: rw, gate: g] not_not_lhs_0
    |- g is_not /\ g is_gate /\ [higher: rw, lower: g] neg;
  ax/not_not_lhs1_type : forall rw: Cell, g: Cell.
    rw is_not_not, [rw: rw, gate: g] not_not_lhs_1
    |- g is_not /\ g is_gate /\ [higher: rw, lower: g] neg;
  strict ax/not_not_distinct_0_1 : forall rw: Cell, g: Cell.
    rw is_not_not, [rw: rw, gate: g] not_not_lhs_0, [rw: rw, gate: g] not_not_lhs_1
    |- false;
  strict ax/not_not_wire_m_1 : forall rw: Cell, glhs0: Cell, glhs1: Cell, w: Cell.
    rw is_not_not,
    [rw: rw, gate: glhs0] not_not_lhs_0,
    [rw: rw, gate: glhs1] not_not_lhs_1,
    [gate: glhs0, wire: w] not_out
    |- [gate: glhs1, wire: w] not_in;
  ax/not_not_eq_0 : forall rw: Cell, glhs0: Cell, glhs1: Cell, wa: Cell, wb: Cell.
    rw is_not_not,
    [rw: rw, gate: glhs0] not_not_lhs_0,
    [rw: rw, gate: glhs1] not_not_lhs_1,
    [gate: glhs0, wire: wa] not_in,
    [gate: glhs1, wire: wb] not_out
    |- wa = wb;

  // --- const0_not ---
  ax/const0_not_lhs0_type : forall rw: Cell, g: Cell.
    rw is_const0_not, [rw: rw, gate: g] const0_not_lhs_0
    |- g is_const0 /\ g is_gate /\ [higher: rw, lower: g] neg;
  ax/const0_not_lhs1_type : forall rw: Cell, g: Cell.
    rw is_const0_not, [rw: rw, gate: g] const0_not_lhs_1
    |- g is_not /\ g is_gate /\ [higher: rw, lower: g] neg;
  ax/const0_not_rhs0_type : forall rw: Cell, g: Cell.
    rw is_const0_not, [rw: rw, gate: g] const0_not_rhs_0
    |- g is_const1 /\ g is_gate /\ [higher: rw, lower: g] pos;
  strict ax/const0_not_distinct_0_1 : forall rw: Cell, g: Cell.
    rw is_const0_not, [rw: rw, gate: g] const0_not_lhs_0, [rw: rw, gate: g] const0_not_lhs_1
    |- false;
  strict ax/const0_not_distinct_0_2 : forall rw: Cell, g: Cell.
    rw is_const0_not, [rw: rw, gate: g] const0_not_lhs_0, [rw: rw, gate: g] const0_not_rhs_0
    |- false;
  strict ax/const0_not_distinct_1_2 : forall rw: Cell, g: Cell.
    rw is_const0_not, [rw: rw, gate: g] const0_not_lhs_1, [rw: rw, gate: g] const0_not_rhs_0
    |- false;
  strict ax/const0_not_wire_m_1 : forall rw: Cell, glhs0: Cell, glhs1: Cell, w: Cell.
    rw is_const0_not,
    [rw: rw, gate: glhs0] const0_not_lhs_0,
    [rw: rw, gate: glhs1] const0_not_lhs_1,
    [gate: glhs0, wire: w] const0_out
    |- [gate: glhs1, wire: w] not_in;
  strict ax/const0_not_wire_y_1 : forall rw: Cell, glhs1: Cell, grhs0: Cell, w: Cell.
    rw is_const0_not,
    [rw: rw, gate: glhs1] const0_not_lhs_1,
    [rw: rw, gate: grhs0] const0_not_rhs_0,
    [gate: glhs1, wire: w] not_out
    |- [gate: grhs0, wire: w] const1_out;

  // --- const1_not ---
  ax/const1_not_lhs0_type : forall rw: Cell, g: Cell.
    rw is_const1_not, [rw: rw, gate: g] const1_not_lhs_0
    |- g is_const1 /\ g is_gate /\ [higher: rw, lower: g] neg;
  ax/const1_not_lhs1_type : forall rw: Cell, g: Cell.
    rw is_const1_not, [rw: rw, gate: g] const1_not_lhs_1
    |- g is_not /\ g is_gate /\ [higher: rw, lower: g] neg;
  ax/const1_not_rhs0_type : forall rw: Cell, g: Cell.
    rw is_const1_not, [rw: rw, gate: g] const1_not_rhs_0
    |- g is_const0 /\ g is_gate /\ [higher: rw, lower: g] pos;
  strict ax/const1_not_distinct_0_1 : forall rw: Cell, g: Cell.
    rw is_const1_not, [rw: rw, gate: g] const1_not_lhs_0, [rw: rw, gate: g] const1_not_lhs_1
    |- false;
  strict ax/const1_not_distinct_0_2 : forall rw: Cell, g: Cell.
    rw is_const1_not, [rw: rw, gate: g] const1_not_lhs_0, [rw: rw, gate: g] const1_not_rhs_0
    |- false;
  strict ax/const1_not_distinct_1_2 : forall rw: Cell, g: Cell.
    rw is_const1_not, [rw: rw, gate: g] const1_not_lhs_1, [rw: rw, gate: g] const1_not_rhs_0
    |- false;
  strict ax/const1_not_wire_m_1 : forall rw: Cell, glhs0: Cell, glhs1: Cell, w: Cell.
    rw is_const1_not,
    [rw: rw, gate: glhs0] const1_not_lhs_0,
    [rw: rw, gate: glhs1] const1_not_lhs_1,
    [gate: glhs0, wire: w] const1_out
    |- [gate: glhs1, wire: w] not_in;
  strict ax/const1_not_wire_y_1 : forall rw: Cell, glhs1: Cell, grhs0: Cell, w: Cell.
    rw is_const1_not,
    [rw: rw, gate: glhs1] const1_not_lhs_1,
    [rw: rw, gate: grhs0] const1_not_rhs_0,
    [gate: glhs1, wire: w] not_out
    |- [gate: grhs0, wire: w] const0_out;

  // --- and_const1 ---
  ax/and_const1_lhs0_type : forall rw: Cell, g: Cell.
    rw is_and_const1, [rw: rw, gate: g] and_const1_lhs_0
    |- g is_const1 /\ g is_gate /\ [higher: rw, lower: g] neg;
